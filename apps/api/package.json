{
  "name": "@circutrace/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --no-file-parallelism",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@circutrace/shared-types": "workspace:*",
    "@circutrace/validation": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "zod": "^4.6.7",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "vitest": "^4.1.12",
    "@types/cookie-parser": "^1.4.8"
  }
}
